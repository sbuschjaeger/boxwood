{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "Python_EXECUTABLE": "${sourceDir}/.venv/bin/python"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug with sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BOXWOOD_SANITIZE": "ON",
        "BOXWOOD_PYTHON": "OFF"
      }
    },
    {
      "name": "clang",
      "displayName": "Release with Clang",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "Python_EXECUTABLE": "${sourceDir}/.venv/bin/python"
      }
    },
    {
      "name": "aarch64",
      "displayName": "Release for 64-bit ARM Linux (cross, tests in qemu)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/aarch64",
      "toolchainFile": "${sourceDir}/cmake/aarch64-linux-gnu.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BOXWOOD_PYTHON": "OFF"
      }
    }
  ]
}
